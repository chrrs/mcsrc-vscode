{
    "name": "mcsrc-vscode-extension",
    "displayName": "mcsrc",
    "description": "Preview Minecraft decompiled classes via mcsrc:// scheme.",
    "version": "0.0.1",
    "private": true,
    "publisher": "mcsrc",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onUri:mcsrc"
    ],
    "browser": "./dist/web/extension",
    "contributes": {
        "commands": [
            {
                "command": "mcsrc.changeVersion",
                "title": "Set Minecraft Version",
                "category": "MCSRC"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "mcsrc.classes",
                    "name": "Minecraft Classes"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "mcsrc.changeVersion",
                    "when": "view == mcsrc.classes",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "build": "vite build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@types/node": "^24.6.0",
        "@types/vscode": "^1.90.0",
        "@vscode/test-web": "^0.0.78",
        "npm-run-all": "^4.1.5",
        "typescript": "~5.9.3",
        "vite": "^6.0.0",
        "vite-plugin-static-copy": "^3.1.4"
    },
    "dependencies": {
        "@katana-project/zip": "^0.7.1",
        "@run-slicer/vf": "^0.3.2-1.11.2",
        "rxjs": "^7.8.2",
        "vitest": "^3.2.4",
        "vscode-web": "^1.91.1"
    }
}